# Copy the relevant example into a gitignored .env / .env.local — never commit secrets.
# Canonical names (Phase 01):

# Clients (EXPO_PUBLIC_* / NEXT_PUBLIC_* only)
# EXPO_PUBLIC_API_BASE_URL / NEXT_PUBLIC_API_BASE_URL
# EXPO_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL
# EXPO_PUBLIC_SUPABASE_ANON_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY

# Backend — see backend/.env.example
# DATABASE_URL
# REDIS_URL
# SUPABASE_URL
# SUPABASE_ANON_KEY
# SUPABASE_SERVICE_ROLE_KEY   # backend only
# SUPABASE_JWT_AUDIENCE       # default authenticated
# Catalog writes go through FastAPI only — do not open PostgREST writes to anon.
# RAZORPAY_KEY_ID
# RAZORPAY_KEY_SECRET
# EXPO_PUBLIC_MAP_STYLE_URL   # demo MapLibre style for SOS map
# SOS_STUB_DISPATCH_SECONDS
# SOS_OPS_PHONE_E164
