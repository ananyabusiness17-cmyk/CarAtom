# Copy to a gitignored .env — never commit values.
# Canonical production NAMES. See docs/release/PRODUCTION-env-inventory.md

# API
# ENV=production
# API_VERSION=1.0.0
# DATABASE_URL=          # Supabase pooler + ?sslmode=require
# REDIS_URL=             # Railway private Redis
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # backend only
# SUPABASE_JWT_AUDIENCE=authenticated
# CORS_ORIGINS=["https://admin.caratom.in"]
# RAZORPAY_MODE=live
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# INVOICE_GSTIN=
# INVOICE_LEGAL_NAME=
# INVOICE_SAC=998729
# STAGING_LINK_BASE=https://app.caratom.in/l
# SMS_PROVIDER=fake
# WHATSAPP_PROVIDER=fake

# Clients (EAS / Next public)
# EXPO_PUBLIC_API_BASE_URL=https://api.caratom.in
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_LEGAL_BASE_URL=https://admin.caratom.in
# NEXT_PUBLIC_API_BASE_URL=https://api.caratom.in
# NEXT_PUBLIC_ENV=production
