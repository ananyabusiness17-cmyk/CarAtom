# Local backend (only when `uvicorn` is running on this PC):
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Expo Go on a phone — use Railway (localhost / :8000 on the LAN IP will not work):
EXPO_PUBLIC_API_BASE_URL=https://caratom-production.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public Razorpay key (test). Secret stays on the API only.
EXPO_PUBLIC_RAZORPAY_KEY_ID=
EXPO_PUBLIC_LEGAL_BASE_URL=https://admin.caratom.in

# OpenStreetMap raster tiles (Civic Agent pattern). Leave unset to use OSM.
# Optional vector override for a later production CDN:
# EXPO_PUBLIC_MAP_STYLE_URL=

# On a physical phone, leave API_BASE_URL as localhost — the app uses the Metro LAN
# host (same as the Expo QR) and talks to the API on port 8000.
# The API must bind 0.0.0.0, not 127.0.0.1.
