# Active: local API. Expo Go rewrites localhost to this PC's Wi-Fi IP, port 8000.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Railway (paused). When it is back, comment the line above and uncomment this:
# EXPO_PUBLIC_API_BASE_URL=https://caratom-production.up.railway.app
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Metro / Expo Go only. Never set this in a production or preview EAS build.
EXPO_PUBLIC_DEV_LOCAL_AUTH=1
# OpenStreetMap raster tiles by default. Optional vector override:
# EXPO_PUBLIC_MAP_STYLE_URL=
