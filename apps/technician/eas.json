{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "internal": {
      "distribution": "internal",
      "channel": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.caratom.in"
      }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.caratom.in"
      }
    }
  }
}
