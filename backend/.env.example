ENV=development
API_VERSION=1.0.0
ENABLE_DEV_SIMULATE=true

# Phase 05 SOS stub (lazy-advance on GET; honest copy, not live dispatch)
SOS_STUB_DISPATCH_SECONDS=90
SOS_OPS_PHONE_E164=+918012345678

# Database — use Docker local OR Supabase connection string
DATABASE_URL=postgresql://caratom:caratom_dev@localhost:5432/caratom

# Redis — local Docker OR Railway
REDIS_URL=redis://localhost:6379/0

# Supabase (Phase 02+ auth; Phase 01 optional for DB URL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

SLOT_HOLD_MINUTES=15
SLOT_CAPACITY=3
OPERATING_HOURS=09:00-18:00
# on catalog or profile tables (DATA-RLS-001).
# SUPABASE_SERVICE_ROLE_KEY stays on the backend only — never in Expo/Next public env.


# Razorpay (Phase 08 — test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
INVOICE_PDF_BUCKET=caratom-invoices
INVOICE_GSTIN=
INVOICE_LEGAL_NAME=
INVOICE_SAC=998729

# Supabase Storage (Phase 06)
SUPABASE_STORAGE_BUCKET_EVIDENCE=caratom-evidence
SIGNED_UPLOAD_TTL_SECONDS=3600
MAX_EVIDENCE_BYTES=10485760

# Location ping rate limit
TECH_LOCATION_PING_MIN_INTERVAL_SECONDS=30

# OpenStreetMap Nominatim (Civic Agent pattern — User-Agent is required)
NOMINATIM_USER_AGENT=CARATOM/0.6 (location; https://caratom.in)
NOMINATIM_TIMEOUT_SECONDS=8

# Dev assign (development only)
DEV_AUTO_ASSIGN_TECHNICIAN_ID=

# Phase 11 notifications / outbox (worker holds provider secrets)
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER_ID=CARATM
SMS_TEMPLATE_ID=
WHATSAPP_PROVIDER=fake
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
EXPO_ACCESS_TOKEN=
FORCE_REAL_MESSAGING=false
FAKE_MESSAGING_FAIL_RATE=0
NOTIFICATION_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=50
STAGING_LINK_BASE=https://staging.caratom.app/l
