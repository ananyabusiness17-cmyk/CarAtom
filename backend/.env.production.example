ENV=production
API_VERSION=1.0.0
ENABLE_DEV_SIMULATE=false

# Pooler for API; direct URL for Alembic only (do not put both in the same runtime)
DATABASE_URL=
REDIS_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# JSON array. Production must not include localhost.
CORS_ORIGINS=["https://admin.caratom.in"]

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=live
INVOICE_PDF_BUCKET=caratom-invoices
INVOICE_GSTIN=
INVOICE_LEGAL_NAME=
INVOICE_SAC=998729

SLOT_HOLD_MINUTES=15
SLOT_CAPACITY=3
OPERATING_HOURS=09:00-18:00

SUPABASE_STORAGE_BUCKET_EVIDENCE=caratom-evidence
SIGNED_UPLOAD_TTL_SECONDS=3600
MAX_EVIDENCE_BYTES=10485760
TECH_LOCATION_PING_MIN_INTERVAL_SECONDS=30

NOMINATIM_USER_AGENT=CARATOM/1.0 (location; https://caratom.in)
NOMINATIM_TIMEOUT_SECONDS=8

# Messaging: keep fake until DLT + WhatsApp templates (ADR-011)
SMS_PROVIDER=fake
SMS_API_KEY=
SMS_SENDER_ID=CARATM
SMS_TEMPLATE_ID=
WHATSAPP_PROVIDER=fake
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=
EXPO_ACCESS_TOKEN=
FORCE_REAL_MESSAGING=false
NOTIFICATION_MAX_ATTEMPTS=8
OUTBOX_BATCH_SIZE=50
STAGING_LINK_BASE=https://app.caratom.in/l
LOG_LEVEL=info
